# Copy to .env and fill in. Required only to RUN the generation engine.
# Get a key at https://console.anthropic.com/  (never commit the real .env)
ANTHROPIC_API_KEY=sk-ant-...

# VOICE — LiveKit, and nothing else.
#
# These three power BOTH the live Voice-agent call (Agent Studio -> a Voice workflow ->
# Preview Workflow -> Start Call) AND the Details tab's voice preview button. There are
# deliberately no Deepgram or ElevenLabs keys here any more: both vendors were removed
# 9/3/2026 and everything voice goes through LiveKit on LiveKit credentials.
# `npm run audit:voice` fails if a direct call to either vendor's API comes back.
#
# Get these from the LiveKit Cloud dashboard -> Settings -> Keys.
# Without them the workflow page says voice calls are not configured, rather than
# falling back to a different-sounding agent.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
#
# The hosted worker that answers those calls lives in agent/ and is deployed separately
# with `lk agent deploy` — see agent/DEPLOY.md.

# OPTIONAL — PRODUCTION HOSTING (server.ts). Not needed for local `npm run dev`.
# PORT the production server listens on (Render sets this automatically).
PORT=
# "Sign in with Google" gate — set BOTH client id + secret to require login.
# Create an OAuth client at https://console.cloud.google.com (Web application),
# with Authorized redirect URI = <BASE_URL>/auth/callback . Leave blank = no gate.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in (defaults to invoca.com if unset).
ALLOWED_EMAIL_DOMAIN=invoca.com
# Random string that signs the login cookie — generate with `openssl rand -hex 32`.
SESSION_SECRET=
# Public URL of the deployment, e.g. https://invoca-demo.onrender.com (used to
# build the OAuth redirect). If unset, it's derived from the incoming request.
BASE_URL=

# OPTIONAL — Gumloop agent that builds the 3 HTML leave-behinds (Voice Screenpop,
# SMS Screenpop, Voice Routing Demo) from just the customer URL, in parallel with
# the platform demo. Without these the artifacts stay unseeded (My Reports simply
# won't show the rows). Get your API key at Gumloop → Settings → API / Credentials.
GUMLOOP_API_KEY=
# Your Gumloop workspace/user id (shown in the "Run via API" panel of a flow).
GUMLOOP_USER_ID=
# Pipeline (saved-item) IDs — one per artifact. If a single pipeline outputs all
# three, put the same id in all three (the code de-dupes the run).
GUMLOOP_PIPELINE_VOICE_SCREENPOP=
GUMLOOP_PIPELINE_SMS_SCREENPOP=
GUMLOOP_PIPELINE_VOICE_ROUTING_DEMO=

# Optional: Mapbox PUBLIC token (pk.…) for the ChatGPT ad screen's map.
# The real ChatGPT page uses Mapbox; with this set our map matches it exactly.
# Public tokens are meant to ship in browser code — restrict it by URL in the
# Mapbox dashboard. Without it the map falls back to tinted CARTO tiles.
VITE_MAPBOX_TOKEN=

# Optional: Google Places API (New) key for REAL business photos, ratings, hours,
# address and phone in the ChatGPT sponsored placement flyout.
# SECRET, server-side only — do NOT add a VITE_ prefix, it must never reach the
# browser. Enable "Places API (New)" in Google Cloud, restrict the key to that
# API, and add it here + in Render. Without it the flyout falls back to the
# prospect og:image, then the brand mark.
GOOGLE_PLACES_API_KEY=

# ---- Feedback completion emails (optional) ----------------------------------
# PREFERRED: Gmail API, because Invoca's Workspace blocks app passwords.
# It reuses the GOOGLE_CLIENT_ID / SECRET above, so there is no second app to
# register. Get the refresh token by visiting /auth/gmail on the LIVE site as an
# admin and following the one-time consent; the page shows the value once.
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
#
# FALLBACK: SMTP with an app password. Dead on arrival if the Workspace disables
# app passwords ("The setting you are looking for is not available for your
# account"), which is why the Gmail route above exists.
# Sends FROM your own @invoca.com address TO whoever submitted the feedback, when
# you mark their item Complete on /feedback. Leave blank and everything still
# works; the notification is simply skipped and logged.
#
# SMTP_APP_PASSWORD is a Google APP PASSWORD (16 characters), not your account
# password. Create one at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification on the account).
SMTP_USER=
SMTP_APP_PASSWORD=
# Optional overrides. Defaults are Gmail's, which is what Workspace uses.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM_NAME=Invoca Demo Generator

# --- Demo Call Ingest-O-Matic (optional) -------------------------------------
# Per-network Invoca Call Ingestion API credentials. Without a network's four
# vars, Ingest-O-Matic runs fine but that network's requests will fail — the
# server logs which networks are missing credentials at boot.
# ALSO REQUIRES ANTHROPIC_API_KEY above: each ingestion run is a real Claude
# Agent SDK session, not a direct API call.
INVOCA_API_TOKEN_TELECOM=
INVOCA_NETWORK_ID_TELECOM=
INVOCA_CAMPAIGN_ID_TELECOM=
INVOCA_ENDPOINT_TELECOM=
INVOCA_API_TOKEN_HEALTHCARE=
INVOCA_NETWORK_ID_HEALTHCARE=
INVOCA_CAMPAIGN_ID_HEALTHCARE=
INVOCA_ENDPOINT_HEALTHCARE=
# Optional: which Claude model runs each ingestion agent (defaults to the CLI's
# own default model if unset).
INGEST_AGENT_MODEL=
# Off outside production by default (like CANARY) — set to "on" to force the
# scheduler to arm locally, or "off" to disable it anywhere.
INGEST_SCHEDULE=

# --- Replicate: render pages in a real browser (optional, recommended) --------
# Without this, Replicate serves a FAST copy: a plain server fetch that cannot run the
# page's JavaScript, so lazy images, background video and JS-injected icons are missing
# (measured on ridgeline-roofing.com: 21 data-src images and 62 lazy images stay unloaded).
# With it, Browserless renders the page in a real browser first and the replica is accurate.
#
# Why a hosted service rather than Chromium on this server: Render enforces memory PER
# CONTAINER, so a browser here would count against this service's limit — and a container OOM
# kills the whole platform with no chance to catch it. Off-box, the worst case is a less
# accurate replica. Free tier (1k units/month, no card) covers normal use.
#   https://browserless.io  ->  account dashboard  ->  API token
BROWSERLESS_TOKEN=
# Optional: a different region or a self-hosted Browserless.
# BROWSERLESS_URL=https://production-sfo.browserless.io/content
