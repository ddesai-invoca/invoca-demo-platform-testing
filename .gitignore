# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.data

# Ingest-O-Matic subagents: network_config.env is materialized at boot from server
# env vars (real Invoca credentials — never committed), state/ is a symlink onto
# DATA_DIR (the persistent disk) so send history survives redeploys, .venv is
# rebuilt on first boot, and generated batch CSVs are working files, not source.
agents/subagents/*/network_config.env
# No trailing slash: state/ is a SYMLINK onto DATA_DIR at runtime (see
# ingestAgentPaths.ts), and a trailing-slash gitignore pattern only matches a
# real directory, not a symlink — with the slash, git tried to add the
# symlink itself.
agents/subagents/*/state
agents/subagents/*/.venv/
agents/subagents/*/*_WITH_URLS*.csv

# transient: extracted capture frames, measured then deleted
public/__m/

# Local-only preview profile (see the Silver/Gold reports before pushing). Never commit.
src/data/generated/health-spring-preview.json

# The LiveKit agent worker has its own dependencies (kept out of the app bundle).
agent/node_modules/
agent/package-lock.json

# LiveKit agent secrets handed to `lk agent create --secrets-file` — never commit these.
agent/*.secrets.env
agent/secrets.env

# Replica captures — GENERATED, and deliberately not committed.
#
# A frozen capture embeds its CSS, fonts and images, so it is measured in megabytes (aviandco
# is 17.8MB) and is DELETED after 10 days by `npm run capture:prune`. Committing one would put
# that weight in git history permanently — git never forgets a blob, so a file we intend to
# throw away in 10 days would cost the repo its full size forever.
#
# Nothing here was ever committed, so this only stops an accidental `git add -A`. To ship a
# specific capture on purpose (a small `--linked` one), add it explicitly with `git add -f`.
public/replicas/*.html
