{
  "name": "invoca-demo-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env --import tsx server.ts",
    "serve": "npm run build && npm start",
    "generate": "node --env-file-if-exists=.env engine/generate.ts",
    "audit": "npm run typecheck && npm run audit:phases && npm run audit:voice && npm run audit:tiers && npm run audit:leads && npm run audit:calllog && npm run audit:leaddetail && npm run audit:clrecord && npm run audit:replicas && npm run audit:sources && npm run audit:place && npm run audit:events && npm run audit:app && npm run audit:admin-notice && npm run audit:alerts && npm run audit:ingest-schedule && node --env-file-if-exists=.env --import tsx scripts/audit-seeds.ts",
    "audit:ingest-schedule": "tsx scripts/audit-ingest-schedule.ts",
    "audit:phases": "tsx scripts/audit-phases.ts",
    "audit:admin-notice": "tsx scripts/audit-admin-notice.ts",
    "audit:ai": "tsx scripts/audit-ai-rules.ts",
    "test:sw": "node scripts/sw-logic.test.mjs",
    "audit:tiers": "tsx scripts/audit-tiers.ts",
    "audit:leads": "tsx scripts/audit-leads.ts",
    "audit:calllog": "tsx scripts/audit-calllog.ts",
    "audit:voice": "tsx scripts/audit-voice.ts",
    "audit:leaddetail": "tsx scripts/audit-leaddetail.ts",
    "audit:clrecord": "tsx scripts/audit-calllogrecord.ts",
    "audit:place": "tsx scripts/audit-place.ts",
    "typecheck": "tsc -b",
    "gen:events": "node --env-file-if-exists=.env --import tsx scripts/generate-event-demos.ts",
    "seed:events": "node --env-file-if-exists=.env --import tsx -e \"import('./engine/eventSeeds.ts').then(m=>console.log(m.importEventSeeds()))\"",
    "audit:events": "tsx scripts/audit-events.ts",
    "audit:app": "tsx scripts/audit-app.ts",
    "audit:alerts": "tsx scripts/audit-alerts.ts",
    "audit:sources": "tsx scripts/audit-sources.ts",
    "audit:replicas": "tsx scripts/audit-replicas.ts",
    "capture": "node --env-file-if-exists=.env --import tsx scripts/capture-url.ts",
    "capture:prune": "node --env-file-if-exists=.env --import tsx scripts/prune-replicas.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@anthropic-ai/sdk": "^0.111.0",
    "@livekit/protocol": "^1.50.4",
    "@types/leaflet": "^1.9.22",
    "@types/nodemailer": "^8.0.1",
    "express": "^4.22.2",
    "leaflet": "^1.9.4",
    "livekit-client": "^2.22.0",
    "livekit-server-sdk": "^2.18.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
